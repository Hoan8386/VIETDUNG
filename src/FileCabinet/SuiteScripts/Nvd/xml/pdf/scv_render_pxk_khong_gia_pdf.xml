<?xml version="1.0" encoding="UTF-8"?>
<pdf>
    <head>
        <link name="times" type="font" subtype="opentype"
              src="${libPdf.font.times?html}"
              src-bold="${libPdf.font.times_bold?html}"
              src-italic="${libPdf.font.times_italic?html}"
              src-bolditalic="${libPdf.font.times_bolditalic?html}"
              bytes="2"/>
        <link name="Arial" type="font" subtype="opentype"
              src="${libPdf.font.arial?html}"
              src-bold="${libPdf.font.arial_bold?html}"
              src-italic="${libPdf.font.arial_italic?html}"
              src-bolditalic="${libPdf.font.arial_bolditalic?html}"
              bytes="2"/>
        <style>
            * {
            font-family: Arial,times;
            }
            table {
            width: 100%;
            border-collapse: collapse;
            font-size: 10px;
            }
            h1 {
            font-family: Arial,times;
            font-size: 18pt;
            }
            th, td {
            padding: 5px;
            }
            th {
            background-color: #f2f2f2;
            font-weight: bold;
            font-size: 12pt;
            }
            p {
            font-size: 10pt;
            }
            .header {
            font-size: 13pt
            }
            .sub-header {
            font-size: 8pt;
            padding-bottom: -5px;

            }
            .no-border {
            border: none;
            }

            .important-header {
            font-size: 10px;
            }
        </style>
    </head>
    <body padding="0.5in 0.3in 0.5in 0.3in" size="A4">
