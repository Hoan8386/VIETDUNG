<!--                    <p  align="right" style="font-size: 10pt; padding: -5px -15px -5px -15px">-->
<!--                        <b>${record.subsidiary.custrecord_scv_o2c_if_kg}</b>-->
<!--                    </p>-->
<!--            </td>-->
        </tr>
        <tr padding="0px 0px 5px 0px">
            <td style="border:none">
                <p style="font-size: 10pt; padding: -5px -5px -5px -5px" align="left">
                    <b>Số đơn hàng:</b>
                </p>
            </td>
            <td style="border:none" colspan="2">
